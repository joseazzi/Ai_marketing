# Required for the chat agent (the autopilot, dashboard and evaluation work without it)
OPENAI_API_KEY=sk-...
# Any OpenAI chat model that supports tool calling
OPENAI_MODEL=gpt-5-mini

# Where the agent keeps data, model, memory, alerts and plans
BUDGET_AGENT_WORKSPACE=workspace

# Optional alert channels (alerts are always written to workspace/alerts.jsonl)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_WEBHOOK_URL=https://example.com/webhook
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# ALERT_EMAIL_TO=marketing-team@example.com
